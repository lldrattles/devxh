[Unit]
Description=DevXH gate %i (DevilutionX headless dedicated server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs unprivileged. If your operator user is named differently (e.g. devxh),
# DO NOT edit this file — override with a drop-in instead:
#   sudo systemctl edit devxh@%i
#     [Service]
#     User=devxh
#     Group=devxh
User=games
# Per-instance configuration: /etc/devxh/%i.env (root-owned, chmod 600).
# Required: DEVXH_NAME, DEVXH_PORT, DEVXH_GAME, DEVXH_DIFFICULTY
# Optional: DEVXH_SERVER_ID, DEVXH_API_KEY (used by devxh-beat@%i)
# See devxh-instance.env.example.
EnvironmentFile=/etc/devxh/%i.env
# %i = instance name (e.g. east). Braced ${VAR} expand as single arguments,
# so names with spaces work. To add --password or --full-quests for one
# instance, override ExecStart the same way as User above.
ExecStart=/opt/devxh/devilutionx-server \
    --data-dir /opt/devxh/assets \
    --save-dir /var/lib/devxh/%i \
    --config-dir /etc/devxh/%i \
    --port ${DEVXH_PORT} \
    --name ${DEVXH_NAME} \
    --game ${DEVXH_GAME} \
    --difficulty ${DEVXH_DIFFICULTY} \
    --server-tcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
