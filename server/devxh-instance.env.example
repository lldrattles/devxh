# DevXH per-instance configuration — copy to /etc/devxh/<NAME>.env
#   sudo cp devxh-instance.env.example /etc/devxh/east.env
#   sudo chmod 600 /etc/devxh/east.env
# One file per gate instance; used by BOTH devxh@<NAME> and devxh-beat@<NAME>.
# <NAME> becomes the systemd instance tag (letters, digits, dashes).

# --- Game (used by devxh@<NAME>) ---
# Name players see in the in-game list
DEVXH_NAME=East
# Unique TCP port per gate on this machine (6112, 6113, 6114 ...)
DEVXH_PORT=6112
# hellfire or diablo
DEVXH_GAME=hellfire
# 0=normal 1=nightmare 2=hell
DEVXH_DIFFICULTY=0

# --- Listing (used by devxh-beat@<NAME>) ---
# From the gate's page on devxh.com/forum (My Gates -> Create Gate)
DEVXH_SERVER_ID=3
DEVXH_API_KEY=devxh_REPLACE_ME

# --- Optional ---
# Capacity reported to the listing (4 = 3 human slots + idle host)
#DEVXH_CAPACITY=4
# Override reported engine version
#DEVXH_VERSION=1.5.5-dev
# Private game (joiners are prompted for the password)
# (add --password via a unit drop-in, see devxh@.service header)
